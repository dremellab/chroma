#!/usr/bin/env python3
import typer
import os
import csv
import json
import shlex
import shutil
import subprocess
import tempfile
import sys
from typing import List, Optional

ALLOWED_HOSTS = {"hg38", "mm39"}
DEFAULT_SLURM_PARTITION = os.environ.get("CHROMA_DEFAULT_SLURM_PARTITION", "standard")
DEFAULT_SLURM_ACCOUNT = os.environ.get("CHROMA_DEFAULT_SLURM_ACCOUNT", "dremel_lab")
DEFAULT_SLURM_TIME = os.environ.get("CHROMA_DEFAULT_SLURM_TIME", "3-00:00:00")
DEFAULT_SLURM_CPUS = os.environ.get("CHROMA_DEFAULT_SLURM_CPUS", "2")
DEFAULT_SLURM_MEM = os.environ.get("CHROMA_DEFAULT_SLURM_MEM", "40G")

REQUIRED_SAMPLESHEET_COLUMNS = ["sample", "fastq_1", "fastq_2", "replicate"]


def resolve_path(path: str) -> str:
    if os.path.isabs(path):
        if os.path.exists(path):
            return path
        raise typer.BadParameter(f"Absolute path '{path}' does not exist.")

    cwd_path = os.path.abspath(os.path.join(os.getcwd(), path))
    if os.path.exists(cwd_path):
        return cwd_path

    # Resolve symlinks so projectDir stays stable regardless of entry path
    script_dir = os.path.dirname(os.path.realpath(__file__))
    script_path = os.path.abspath(os.path.join(script_dir, path))
    if os.path.exists(script_path):
        return script_path

    raise typer.BadParameter(f"Path '{path}' not found relative to current working directory or script directory.")


def validate_samplesheet(path: str) -> str:
    path = resolve_path(path)
    if not os.path.isfile(path):
        raise typer.BadParameter(f"Samplesheet '{path}' does not exist or is not a file.")
    try:
        with open(path, newline="", encoding="utf-8") as handle:
            reader = list(csv.DictReader(handle))
    except OSError as err:
        raise typer.BadParameter(f"Samplesheet '{path}' cannot be read: {err}.")
    if not reader:
        raise typer.BadParameter("Samplesheet must contain a header row and at least one record.")
    columns = [name.strip() for name in reader[0].keys() if name]
    missing = [col for col in REQUIRED_SAMPLESHEET_COLUMNS if col not in columns]
    if missing:
        raise typer.BadParameter("Samplesheet missing required column(s): " + ", ".join(missing))
    return path


def validate_host(value: str) -> str:
    if value not in ALLOWED_HOSTS:
        allowed = ", ".join(sorted(ALLOWED_HOSTS))
        raise typer.BadParameter(f"Invalid host '{value}'. Allowed: {allowed}.")
    return value


def ensure_nextflow_in_path():
    if shutil.which("nextflow") is None:
        typer.echo("Nextflow not found in PATH. Attempting to load 'pipelines' environment...")
        try:
            activate_env = "source $(mamba info --base)/etc/profile.d/conda.sh && mamba activate pipelines"
            subprocess.run(f"bash -c '{activate_env} && which nextflow'", shell=True, check=True)
            typer.echo("Loaded 'pipelines' environment with Nextflow.")
        except subprocess.CalledProcessError:
            raise typer.Exit(code=1)


def run_nextflow_command(
    cmd,
    output_dir,
    submit_slurm: bool = False,
    slurm_options: Optional[List[str]] = None,
):
    if not os.path.isdir(output_dir):
        raise typer.BadParameter(f"Output directory '{output_dir}' does not exist.")
    cmd = [arg for arg in cmd if arg]
    slurm_options = [opt for opt in (slurm_options or []) if opt]
    typer.echo(f"Running command: {' '.join(cmd)} (cwd={output_dir})")
    try:
        if submit_slurm:
            return _submit_command_via_slurm(cmd, output_dir, slurm_options)

        result = subprocess.run(
            cmd, cwd=output_dir, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=True
        )
        return result
    except subprocess.CalledProcessError as e:
        typer.echo(f"Nextflow command failed: {e.stderr.strip()}")
        raise typer.Exit(code=1)


def parse_nextflow_json_output(raw_output: str) -> dict:
    """Parse JSON emitted by `nextflow config -o json`, stripping any trailing logs."""
    cleaned = raw_output.lstrip()
    try:
        return json.loads(cleaned)
    except json.JSONDecodeError:
        decoder = json.JSONDecoder()
        try:
            parsed, idx = decoder.raw_decode(cleaned)
        except json.JSONDecodeError as err:
            typer.echo("Error: Unable to parse JSON from `nextflow config -o json` output.")
            raise typer.Exit(code=1) from err

        trailing = cleaned[idx:].strip()
        if trailing:
            preview = trailing.splitlines()[0]
            typer.echo(
                "Warning: Ignoring extra Nextflow output appended after JSON: "
                + (preview[:120] + ("..." if len(preview) > 120 else ""))
            )
        return parsed


def _coerce_value(value: str):
    lower = value.lower()
    if lower == "true":
        return True
    if lower == "false":
        return False
    if lower == "null":
        return None
    if value.startswith('"') and value.endswith('"'):
        return value[1:-1]
    if value.startswith("'") and value.endswith("'"):
        return value[1:-1]
    try:
        return int(value)
    except ValueError:
        try:
            return float(value)
        except ValueError:
            return value


def parse_params_config(path: str) -> dict:
    params = {}
    try:
        with open(path, encoding="utf-8") as cfg:
            for raw_line in cfg:
                line = raw_line.strip()
                if not line or line.startswith(("//", "#")):
                    continue
                if line.startswith("params"):
                    continue
                if line in {"{", "}"}:
                    continue
                if "=" not in line:
                    continue
                key, value = line.split("=", 1)
                key = key.strip()
                cleaned = value.strip().rstrip(",")
                params[key] = _coerce_value(cleaned)
    except OSError:
        return {}
    return params


def _format_config_value(value):
    if isinstance(value, str):
        escaped = value.replace('"', '\\"')
        return f'"{escaped}"'
    if isinstance(value, bool):
        return "true" if value else "false"
    if value is None:
        return "null"
    return value


def write_params_config(path: str, params: dict):
    with open(path, "w", encoding="utf-8") as cfg:
        cfg.write("params {\n")
        for k, v in params.items():
            cfg.write(f"    {k} = {_format_config_value(v)}\n")
        cfg.write("}\n")


def _format_cli_value(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    if value is None:
        return "null"
    return str(value)


def get_git_metadata(repo_path: str) -> dict:
    """Return git branch and commit metadata for the given repo path."""
    metadata = {"branch": None, "commit": None}
    if shutil.which("git") is None:
        return metadata

    def _git_output(args):
        try:
            result = subprocess.run(
                ["git", *args],
                cwd=repo_path,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                check=True,
            )
            return result.stdout.strip()
        except (subprocess.CalledProcessError, FileNotFoundError):
            return None

    is_repo = _git_output(["rev-parse", "--is-inside-work-tree"])
    if (is_repo or "").lower() != "true":
        return metadata

    branch = _git_output(["rev-parse", "--abbrev-ref", "HEAD"])
    if branch == "HEAD":
        branch = _git_output(["symbolic-ref", "--short", "HEAD"]) or branch

    metadata["branch"] = branch
    metadata["commit"] = _git_output(["rev-parse", "HEAD"])
    return metadata


def _submit_command_via_slurm(cmd, output_dir, slurm_options: List[str]):
    if shutil.which("sbatch") is None:
        raise typer.BadParameter("sbatch command not found in PATH; cannot submit to Slurm.")

    cmd_str = " ".join(shlex.quote(part) for part in cmd)
    script_contents = (
        f"#!/bin/bash\n"
        "set -euo pipefail\n"
        f"cd {shlex.quote(output_dir)}\n"
        "source /project/dremel_lab/scripts/.sh_common\n"
        "mamba activate pipelines\n"
        f"{cmd_str}\n"
    )
    with tempfile.NamedTemporaryFile(
        "w", delete=False, encoding="utf-8", dir=output_dir, prefix="nf_sbatch_", suffix=".sh"
    ) as tmp_script:
        tmp_script.write(script_contents)
        script_path = tmp_script.name

    os.chmod(script_path, 0o750)

    stdout_path = f"{script_path}.out"
    stderr_path = f"{script_path}.err"

    def _has_option(options: List[str], names: List[str]) -> bool:
        idx = 0
        while idx < len(options):
            token = options[idx]
            for name in names:
                if token == name:
                    return True
                if token.startswith(f"{name}="):
                    return True
                if len(name) == 2 and token.startswith(name) and len(token) > 2:
                    return True
            idx += 1
        return False

    def _ensure_option(options: List[str], names: List[str], value: str):
        if not value:
            return
        if not _has_option(options, names):
            options.append(f"{names[0]}={value}")

    slurm_opts = list(slurm_options)
    _ensure_option(slurm_opts, ["--partition", "-p"], DEFAULT_SLURM_PARTITION)
    _ensure_option(slurm_opts, ["--account", "-A"], DEFAULT_SLURM_ACCOUNT)
    _ensure_option(slurm_opts, ["--time"], DEFAULT_SLURM_TIME)
    _ensure_option(slurm_opts, ["--cpus-per-task", "-c"], DEFAULT_SLURM_CPUS)
    _ensure_option(slurm_opts, ["--mem"], DEFAULT_SLURM_MEM)

    slurm_cmd = [
        "sbatch",
        "--parsable",
        f"--output={stdout_path}",
        f"--error={stderr_path}",
        *slurm_opts,
        script_path,
    ]
    typer.echo(f"Submitting via Slurm: {' '.join(slurm_cmd)}")

    result = subprocess.run(slurm_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=True)

    slurm_stdout = result.stdout.strip()
    job_id = slurm_stdout.split(";")[0] if slurm_stdout else ""
    if not job_id:
        raise subprocess.CalledProcessError(1, slurm_cmd, output=result.stdout, stderr=result.stderr)

    typer.echo(f"Submitted Slurm job {job_id}")
    typer.echo(f"Logs: {stdout_path} (out), {stderr_path} (err)")

    try:
        os.remove(script_path)
    except OSError:
        pass

    return job_id


def prepare_reference_files(host: str, viruses: str, reference_dir: str, ref_dir: str):
    host_fasta = os.path.join(reference_dir, f"{host}.fa")
    host_gtf = os.path.join(reference_dir, f"{host}.gtf")
    if not os.path.exists(host_fasta):
        raise typer.BadParameter(f"Missing host FASTA: {host_fasta}")
    if not os.path.exists(host_gtf):
        raise typer.BadParameter(f"Missing host GTF: {host_gtf}")

    virus_list = [v.strip() for v in viruses.split(",")] if viruses else []
    fasta_files = [host_fasta]
    gtf_files = [host_gtf]

    for virus in virus_list:
        vfasta = os.path.join(reference_dir, f"{virus}.fa")
        vgtf = os.path.join(reference_dir, f"{virus}.gtf")
        if not os.path.exists(vfasta):
            raise typer.BadParameter(f"Missing virus FASTA: {vfasta}")
        if not os.path.exists(vgtf):
            raise typer.BadParameter(f"Missing virus GTF: {vgtf}")
        fasta_files.append(vfasta)
        gtf_files.append(vgtf)

    ref_fasta = os.path.join(ref_dir, "ref.fa")
    ref_gtf = os.path.join(ref_dir, "ref.gtf")

    with open(ref_fasta, "w", encoding="utf-8") as out_fasta:
        for f in fasta_files:
            with open(f, "r", encoding="utf-8") as fin:
                shutil.copyfileobj(fin, out_fasta)
    with open(ref_gtf, "w", encoding="utf-8") as out_gtf:
        for g in gtf_files:
            with open(g, "r", encoding="utf-8") as gin:
                shutil.copyfileobj(gin, out_gtf)

    typer.echo(f"Created combined reference: {ref_fasta}, {ref_gtf}")
    return os.path.abspath(ref_fasta), os.path.abspath(ref_gtf)


app = typer.Typer()


@app.command()
def main(
    output: str = typer.Option(
        ...,
        "--output",
        help="Output directory where results will be saved. Required. Subfolders will be created as needed.",
    ),
    input: str = typer.Option(
        ...,
        "--input",
        callback=validate_samplesheet,
        help="CSV samplesheet with required columns: sample, fastq_1, fastq_2, replicate.",
    ),
    host: str = typer.Option(
        ..., "--host", callback=validate_host, help="Host genome reference FASTA file path. Allowed: hg38, mm39."
    ),
    reference_dir: str = typer.Option(
        "/standard/dremel_lab/workflows/reference_data/fasta_gtf",
        help="Directory containing reference genome FASTA and GTF files.",
    ),
    viruses: str = typer.Option(None, help="Comma-separated list of viral genomes to include in reference."),
    fragment_size: int = typer.Option(200, help="Estimated fragment size used to extend single-end reads."),
    fingerprint_bins: int = typer.Option(5000, help="Number of genomic bins used in fingerprint QC plots."),
    read_length: int = typer.Option(100, help="Read length for genome size calculations and peak calling."),
    with_control: bool = typer.Option(False, help="Indicates if controls are specified in the samplesheet."),
    skip_trimming: bool = typer.Option(False, help="Skip adapter trimming step."),
    save_trimmed: bool = typer.Option(False, help="Save trimmed FastQ files."),
    min_trimmed_reads: int = typer.Option(
        10000, help="Minimum trimmed reads threshold below which samples are discarded."
    ),
    aligner: str = typer.Option("bowtie2", help="Aligner program to use."),
    bwa_min_score: int = typer.Option(None, help="Minimum BWA MEM alignment score for saving an alignment."),
    keep_mito: bool = typer.Option(False, help="Keep mitochondrial reads instead of filtering."),
    keep_dups: bool = typer.Option(False, help="Do not filter duplicate reads."),
    keep_multi_map: bool = typer.Option(False, help="Allow multi-mapped reads."),
    skip_merge_replicates: bool = typer.Option(False, help="Skip merging replicates."),
    save_align_intermeds: bool = typer.Option(False, help="Save intermediate BAM files."),
    broad_cutoff: float = typer.Option(0.1, help="Broad peak cutoff value for MACS2."),
    macs_fdr: float = typer.Option(None, help="FDR cutoff for peak detection in MACS2."),
    macs_pvalue: float = typer.Option(None, help="P-value cutoff for peak detection in MACS2."),
    min_reps_consensus: int = typer.Option(1, help="Minimum replicates to support consensus peak."),
    save_macs_pileup: bool = typer.Option(False, help="Save normalized bedGraph files."),
    skip_peak_qc: bool = typer.Option(False, help="Skip peak QC plots."),
    skip_peak_annotation: bool = typer.Option(False, help="Skip annotating peaks."),
    skip_consensus_peaks: bool = typer.Option(False, help="Skip consensus peak generation."),
    deseq2_vst: bool = typer.Option(True, help="Use variance stabilizing transformation for DESeq2."),
    skip_deseq2_qc: bool = typer.Option(False, help="Skip DESeq2 QC plots."),
    nxf_debug: bool = typer.Option(False, help="Enable verbose Nextflow logging (sets NXF_DEBUG=2)."),
    skip_qc: bool = typer.Option(False, help="Skip all QC except MultiQC."),
    skip_fastqc: bool = typer.Option(False, help="Skip FastQC."),
    skip_picard_metrics: bool = typer.Option(False, help="Skip Picard metrics."),
    skip_preseq: bool = typer.Option(True, help="Skip Preseq analysis."),
    skip_plot_profile: bool = typer.Option(False, help="Skip deepTools plotProfile."),
    skip_plot_fingerprint: bool = typer.Option(False, help="Skip deepTools plotFingerprint."),
    skip_ataqv: bool = typer.Option(False, help="Skip Ataqv QC."),
    skip_igv: bool = typer.Option(False, help="Skip IGV generation."),
    skip_multiqc: bool = typer.Option(False, help="Skip MultiQC report generation."),
    mito_name: str = typer.Option("chrM", help="Mitochondrial chromosome name."),
    slurm_option: Optional[List[str]] = typer.Option(
        None,
        "--slurm-option",
        help="Additional sbatch options (may be passed multiple times).",
    ),
):
    resume = True
    if not os.path.exists(output):
        resume = False  # New run so cannot resume
        typer.echo(f"Creating output directory: {output}")
        os.makedirs(output)
        ref_dir = os.path.join(output, "ref")
        os.makedirs(ref_dir, exist_ok=True)
        fasta_path, gtf_path = prepare_reference_files(host, viruses, reference_dir, ref_dir)
    else:
        ref_dir = os.path.join(output, "ref")
        fasta_path = os.path.join(ref_dir, "ref.fa")
        gtf_path = os.path.join(ref_dir, "ref.gtf")
        if not os.path.exists(fasta_path) or not os.path.exists(gtf_path):
            typer.echo(
                f"Warning: Reference files not found in existing output directory '{output}'. Expected: {fasta_path}, {gtf_path}. Creating them."
            )
            fasta_path, gtf_path = prepare_reference_files(host, viruses, reference_dir, ref_dir)

    ensure_nextflow_in_path()

    script_dir = os.path.dirname(os.path.abspath(__file__))
    git_metadata = get_git_metadata(script_dir)
    main_nf_path = os.path.join(script_dir, "main.nf")
    if not os.path.isfile(main_nf_path):
        typer.echo(f"Error: main.nf not found in {script_dir}")
        raise typer.Exit(code=1)

    config_json_path = os.path.join(output, "tmp.json")
    cmd = ["nextflow", "config", str(main_nf_path), "-profile", "rivanna", "-o", "json"]
    result = run_nextflow_command(cmd, output)
    nf_config = parse_nextflow_json_output(result.stdout)

    with open(config_json_path, "w", encoding="utf-8") as outfile:
        json.dump(nf_config, outfile, indent=2)
    nf_params = nf_config.get("params", {})
    chroma_version = nf_config.get("manifest", {}).get("version")
    metadata_path = os.path.join(output, "chroma_metadata.json")
    metadata_content = {
        "chroma_version": chroma_version,
        "git_branch": git_metadata.get("branch"),
        "git_commit": git_metadata.get("commit"),
    }
    with open(metadata_path, "w", encoding="utf-8") as meta_file:
        json.dump(metadata_content, meta_file, indent=2)
    typer.echo(f"Wrote chroma metadata to {metadata_path}")
    main_args = locals()
    differing = {k: v for k, v in main_args.items() if k in nf_params and nf_params[k] != v}
    differing.update({"fasta": fasta_path, "gtf": gtf_path})

    config_path = os.path.join(output, "pipeline.config")
    rerun_config_path = os.path.join(output, "rerun.config")
    rerun_params = {}
    if not os.path.exists(config_path):
        write_params_config(config_path, differing)
        typer.echo(f"Wrote params (including fasta/gtf) to {config_path}")
    else:
        existing_params = parse_params_config(config_path)
        rerun_params = {k: v for k, v in differing.items() if existing_params.get(k) != v}
        write_params_config(rerun_config_path, rerun_params)
        typer.echo(
            f"Retained existing pipeline.config; wrote override params to {rerun_config_path} "
            f"({len(rerun_params)} unique entr{'y' if len(rerun_params) == 1 else 'ies'})."
        )

    if resume:
        typer.echo("Resuming previous Nextflow run...")
        resume_flag = "-resume"
    else:
        resume_flag = ""

    cmd = ["nextflow", "run", str(main_nf_path), "-c", str(config_path), "-profile", "rivanna"]
    if resume_flag:
        cmd.append(resume_flag)
    if rerun_params:
        for key, value in rerun_params.items():
            cmd.extend([f"--{key}", _format_cli_value(value)])
    if nxf_debug:
        cmd = ["env", "NXF_DEBUG=2", *cmd]

    typer.echo("Running command:")
    typer.echo(" ".join(shlex.quote(part) for part in cmd))

    job_id = run_nextflow_command(
        cmd,
        output,
        submit_slurm=True,
        slurm_options=slurm_option,
    )
    typer.echo(f"Pipeline submitted to Slurm as job {job_id}.")
    typer.echo(f"Monitor job status with 'squeue -j {job_id}' or view logs described above.")


if __name__ == "__main__":
    app()
